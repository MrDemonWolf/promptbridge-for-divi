{
	"name": "mrdemonwolf/promptbridge-for-divi",
	"description": "A staging-alpha bridge between Divi 5 and an independently installed Codex runtime.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "MrDemonWolf, Inc.",
			"homepage": "https://www.mrdemonwolf.com"
		}
	],
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.2"
	},
	"scripts": {
		"analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
		"lint": "phpcs --standard=phpcs.xml.dist",
		"lint:fix": "phpcbf --standard=phpcs.xml.dist",
		"test": "phpunit --configuration=phpunit.xml.dist",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.3.0"
		},
		"sort-packages": true
	}
}
