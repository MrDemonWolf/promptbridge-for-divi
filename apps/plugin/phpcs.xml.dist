<?xml version="1.0"?>
<ruleset name="PromptBridge for Divi">
	<description>WordPress coding standards for PromptBridge for Divi.</description>
	<file>promptbridge-for-divi.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="basepath" value="." />
	<arg name="colors" />
	<arg value="sp" />
	<rule ref="WordPress-Extra" />
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="promptbridge-for-divi" />
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mdw_pbd" />
				<element value="MDW_PBD" />
				<element value="MrDemonWolf" />
			</property>
		</properties>
	</rule>
	<config name="minimum_supported_wp_version" value="6.7" />
	<config name="testVersion" value="8.3-" />
</ruleset>
